# Downloader container
# =====================
# Runs apps/downloader/main.py — fetches one day of BZP API data and writes
# the JSON payload to the configured output directory.
#
# Output destination is controlled by RUNTIME_ENV + LAKEHOUSE_BUCKET (GCP) or
# LOCAL_DATA_ROOT (local).  See config/runtime_gcp.env.example.
#
# In the GCP daily pipeline this container is triggered as a Cloud Run Job by
# the bzp-daily Cloud Workflow (workflows/daily.yaml) before the Dataproc Spark batches.
#
# Build:
#   docker build -t procurement-downloader -f Dockerfile.downloader .

FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src/ src/

# Install core deps + GCP extras for GCS write support.
RUN pip install --no-cache-dir ".[gcp]"

COPY scripts/ scripts/
COPY apps/ apps/
COPY refs/ refs/

ENV PYTHONPATH=/app/src

ARG GIT_SHA=unknown
ENV GIT_COMMIT=${GIT_SHA}

CMD ["python", "apps/downloader/main.py"]
