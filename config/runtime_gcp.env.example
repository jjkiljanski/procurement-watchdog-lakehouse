# GCP runtime configuration template
# ------------------------------------
# Copy this file to a location NOT committed to git (e.g. ~/.procurement-gcp.env
# or a Secret Manager-backed volume mount) and fill in all required values.
#
# Usage:
#   export $(grep -v '^#' ~/.procurement-gcp.env | xargs)
#   python scripts/pipeline/build_bronze.py 2025-10-01
#
# Variables marked [REQUIRED] will cause a startup error if unset.
# Variables marked [OPTIONAL] have working defaults.

# Select the GCP provider. [REQUIRED]
RUNTIME_ENV=gcp

# -----------------------------------------------------------------
# Storage
# -----------------------------------------------------------------

# GCS bucket name — no gs:// prefix. [REQUIRED]
# All pipeline data (bronze_raw, bronze, silver, obs) lives here.
LAKEHOUSE_BUCKET=your-project-lakehouse

# -----------------------------------------------------------------
# GCP project & identity
# -----------------------------------------------------------------

# GCP project ID. [REQUIRED]
GCP_PROJECT=your-project-id

# Service account email used by Dataproc Serverless batches. [OPTIONAL]
# If unset, the Compute Engine default service account is used.
# Recommended: create a dedicated SA with roles:
#   roles/dataproc.worker
#   roles/storage.objectAdmin       (on LAKEHOUSE_BUCKET)
#   roles/bigquery.dataEditor       (on BQ_DATASET)
DATAPROC_SERVICE_ACCOUNT=procurement-pipeline@your-project-id.iam.gserviceaccount.com

# -----------------------------------------------------------------
# Dataproc Serverless
# -----------------------------------------------------------------

# Region for Dataproc Serverless batches. [REQUIRED]
# Must match the region where the VPC subnet resides.
DATAPROC_REGION=europe-west1

# VPC subnet for Dataproc Serverless. [OPTIONAL, default: default]
# Use full URI for shared VPC: projects/HOST_PROJECT/regions/REGION/subnetworks/NAME
DATAPROC_SUBNET=default

# Artifact Registry image URI for the Spark runtime container. [REQUIRED]
# Build with:  docker build -f Dockerfile.spark -t <IMAGE_URI> .
#              docker push <IMAGE_URI>
# Tag with the git SHA for reproducibility.
DATAPROC_CONTAINER_IMAGE=europe-west1-docker.pkg.dev/your-project-id/spark/procurement-spark:latest

# -----------------------------------------------------------------
# BigQuery
# -----------------------------------------------------------------

# BigQuery dataset for external tables over silver GCS Parquet. [OPTIONAL]
# Dataset is created by Terraform; tables are managed by
# scripts/ops/setup_bq_external_tables.py.
BQ_DATASET=procurement_silver

# BigQuery dataset for observability tables (pipeline_runs, dq_metrics,
# quarantine_summary). [OPTIONAL, default: procurement_obs]
# Dataset and tables are created automatically on first write by obs.py.
BQ_OBS_DATASET=procurement_obs

# -----------------------------------------------------------------
# Spark (optional overrides)
# -----------------------------------------------------------------

# Extra Spark conf key/value pairs as a JSON object. [OPTIONAL]
# Example: {"spark.executor.memory":"8g","spark.sql.shuffle.partitions":"200"}
SPARK_APP_EXTRA_CONFIG=

# -----------------------------------------------------------------
# Git commit hash injected by CI
# -----------------------------------------------------------------

# Set by CI/CD when building the container or submitting jobs.
# Used by obs.py for lineage tracking. [OPTIONAL]
GIT_COMMIT=
