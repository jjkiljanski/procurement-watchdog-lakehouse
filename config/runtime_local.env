# Local runtime configuration
# ----------------------------
# Source this file before running pipeline scripts locally:
#   source config/runtime_local.env   (bash/zsh)
#   Get-Content config\runtime_local.env | ForEach-Object { ... }  (PowerShell)
#
# All variables have sensible defaults that match the historical local layout.
# Override only what you need to change.

# Select the local filesystem provider (default when unset).
RUNTIME_ENV=local

# Root directory for all data paths resolved by LocalStorageProvider.
# Relative to the working directory from which scripts are run.
# Default: data
LOCAL_DATA_ROOT=data

# Spark master string for local SparkSessions.
# Use local[N] to pin the thread count, or local[*] to use all cores.
# Default: local[*]
SPARK_MASTER=local[*]

# Optional: extra Spark conf key/value pairs as a JSON object.
# Example: SPARK_APP_EXTRA_CONFIG={"spark.driver.memory":"4g"}
# Default: empty (no extra config)
SPARK_APP_EXTRA_CONFIG=
