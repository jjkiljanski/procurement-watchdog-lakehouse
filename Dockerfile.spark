# Dataproc Serverless runtime container
# ======================================
# Used as the custom container image for Dataproc Serverless Spark batches.
#
# Dataproc Serverless injects its own Java (Temurin 17) and Spark at runtime.
# This image provides: Python deps, application code, Iceberg JAR, tini, spark user.
#   - No ENTRYPOINT / CMD — Dataproc injects the PySpark driver command.
#   - tini must be at /usr/bin/tini — required by Dataproc's entrypoint.sh.
#   - spark user (uid 1099) must exist — Dataproc startup runs as this user.
#
# Build and push:
#   docker build -f Dockerfile.spark \
#     --build-arg GIT_SHA=$(git rev-parse --short HEAD) \
#     -t <REGION>-docker.pkg.dev/<PROJECT>/spark/procurement-spark:<TAG> .
#   docker push <REGION>-docker.pkg.dev/<PROJECT>/spark/procurement-spark:<TAG>
#
# TODO (CI/CD): automate build + push on merge to main.
#   See .github/workflows/deploy.yml for the planned workflow stub.

FROM python:3.12-slim

# ---- System deps ----
# tini: required by Dataproc Serverless entrypoint.sh as a minimal init process.
# Dataproc injects its own Java at runtime (JAVA_HOME=/usr/lib/jvm/temurin-17-jdk-amd64)
# so we don't install Java here.
# spark user (uid 1099): Dataproc startup scripts run as this user — pre-create
# so mkdir /home/spark doesn't fail with Permission denied.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tini \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1099 spark \
    && useradd -u 1099 -g 1099 -m -d /home/spark -s /bin/bash spark

# ---- Python deps ----
WORKDIR /app

COPY pyproject.toml .
COPY src/ src/

# Install core deps + GCP extras.
# The [gcp] extra brings in google-cloud-storage, google-cloud-dataproc,
# google-cloud-bigquery for the GCP provider and BQ setup script.
RUN pip install --no-cache-dir ".[gcp]"

# ---- Iceberg Spark runtime JAR ----
# Referenced via jarFileUris in the batch config so Dataproc adds it to the
# Spark classpath on both driver and executors.
RUN curl -fL -o /opt/iceberg-spark-runtime.jar \
    https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/1.5.2/iceberg-spark-runtime-3.5_2.12-1.5.2.jar

# ---- Application code ----
COPY scripts/ scripts/
COPY apps/ apps/
COPY refs/ refs/

ENV PYTHONPATH=/app/src

ARG GIT_SHA=unknown
ENV GIT_COMMIT=${GIT_SHA}

# No ENTRYPOINT — Dataproc Serverless injects the PySpark driver command.
